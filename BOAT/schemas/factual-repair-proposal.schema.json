{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BOAT Factual Repair Proposal",
  "type": "object",
  "required": ["schemaVersion", "engine", "mode", "status", "generatedAt", "approvalRequired", "automaticApplication", "semanticSupport", "claim", "proposal", "artifacts", "findings", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "engine": { "const": "BOAT Factual Repair Proposal" },
    "mode": { "const": "offline-proposal-only" },
    "status": { "enum": ["review_required", "blocked", "unknown"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "approvalRequired": { "const": true },
    "automaticApplication": { "const": false },
    "semanticSupport": { "const": "not_verified" },
    "claim": { "type": ["object", "null"] },
    "proposal": { "type": "object" },
    "artifacts": { "type": "object" },
    "findings": { "type": "array" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
